 "fields": [
  {
   "fieldname": "coupon_title",
   "fieldtype": "Data",
   "label": "Coupon Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "network",
   "fieldtype": "Link",
   "label": "Network",
   "options": "CRM Opt-In Network",
   "description": "Leave blank for a CRM coupon that is not tied to a partner network.",
   "in_list_view": 1
  },
  {
   "fieldname": "applies_to",
   "fieldtype": "Select",
   "label": "Applies To",
   "options": "Flex\nFixed\nBoth",
   "default": "Flex",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Flex: complimentary tokens on a Flex package. Fixed: a percentage off the Fixed package price. Both: each plan gets its own benefit."
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "value_type",
   "fieldtype": "Select",
   "label": "Value Type",
   "options": "flat_tokens\npercentage_of_purchase",
   "depends_on": "eval:doc.applies_to!='Fixed'",
   "mandatory_depends_on": "eval:doc.applies_to!='Fixed'"
  },
  {
   "fieldname": "value",
   "fieldtype": "Float",
   "label": "Value",
   "precision": "2",
   "description": "With Reward by Facility Level on, this is the reward for every level not listed (0 gives nothing).",
   "depends_on": "eval:doc.applies_to!='Fixed'",
   "mandatory_depends_on": "eval:doc.applies_to!='Fixed'"
  },
  {
   "fieldname": "max_tokens",
   "fieldtype": "Int",
   "label": "Max Tokens (cap)",
   "default": "0",
   "description": "0 means no cap. Otherwise the grant never exceeds this number of tokens.",
   "depends_on": "eval:doc.applies_to!='Fixed'"
  },
  {
   "fieldname": "fixed_discount_percent",
   "fieldtype": "Percent",
   "label": "Fixed Plan Discount (%)",
   "depends_on": "eval:doc.applies_to!='Flex'",
   "description": "Percentage off the Fixed package price on the order this coupon is used on.",
   "mandatory_depends_on": "eval:doc.applies_to!='Flex' && !doc.reward_by_level"
  },
  {
   "fieldname": "section_break_level_rewards",
   "fieldtype": "Section Break",
   "label": "Rewards by Facility Level"
  },
  {
   "fieldname": "reward_by_level",
   "fieldtype": "Check",
   "label": "Reward by Facility Level",
   "default": "0",
   "description": "Set a different reward for each facility level. The values above then apply to every level not listed."
  },
  {
   "fieldname": "level_rewards",
   "fieldtype": "Table",
   "label": "Level Rewards",
   "options": "CRM Coupon Level Reward",
   "depends_on": "eval:doc.reward_by_level"
  },
  {
   "fieldname": "section_break_validity",
   "fieldtype": "Section Break",
   "label": "Validity"
  },
  {
   "fieldname": "valid_from",
   "fieldtype": "Date",
   "label": "Valid From",
   "description": "Blank means the coupon has been valid from the start. Inclusive."
  },
  {
   "fieldname": "valid_to",
   "fieldtype": "Date",
   "label": "Valid To",
   "description": "Blank means the coupon never expires. Inclusive; must be on or after Valid From."
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Inactive\nActive\nRevoked",
   "read_only": 1,
   "default": "Inactive",
   "in_list_view": 1,
   "description": "New coupons start Inactive. Enable/Disable switch Inactive and Active; Revoke is terminal."
  },
  {
   "fieldname": "redeemed_count",
   "fieldtype": "Int",
   "label": "Redeemed",
   "read_only": 1,
   "no_copy": 1,
   "default": "0",
   "in_list_view": 1,
   "description": "Live claims (Reserved + Granted). Maintained by the system."
  },
  {
   "fieldname": "section_break_limits",
   "fieldtype": "Section Break",
   "label": "Redemption Limits"
  },
  {
   "fieldname": "max_redemptions",
   "fieldtype": "Int",
   "label": "Max Redemptions",
   "default": "0",
   "description": "0 means unlimited. Cannot be set below the number already redeemed."
  },
  {
   "fieldname": "per_facility_limit",
   "fieldtype": "Int",
   "label": "Per Facility Limit",
   "read_only": 1,
   "default": "1",
   "description": "How many times one facility may use this coupon. Currently fixed at 1."
  },
  {
   "fieldname": "section_break_targeting",
   "fieldtype": "Section Break",
   "label": "Targeting (CRM coupons only)"
  },
  {
   "fieldname": "targeting",
   "fieldtype": "Select",
   "label": "Targeting",
   "options": "\nAssigned Facilities\nFacility Level\nCoupon Code",
   "description": "Required when Network is blank; must be blank when a Network is set."
  },
  {
   "fieldname": "facility_levels",
   "fieldtype": "Small Text",
   "label": "Facility Levels",
   "description": "One level per line. Required only for Facility Level targeting."
  },
  {
   "fieldname": "coupon_code",
   "fieldtype": "Data",
   "label": "Coupon Code",
   "unique": 1,
   "description": "Required only for Coupon Code targeting. A client enters this code to redeem."
  },
  {
   "fieldname": "section_break_display",
   "fieldtype": "Section Break",
   "label": "Display and Notes"
  },
  {
   "fieldname": "client_label",
   "fieldtype": "Data",
   "label": "Client Label",
   "description": "Optional text shown to clients in the complimentary line description."
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description",
   "description": "Internal notes."
  },
  {
   "fieldname": "section_break_status_audit",
   "fieldtype": "Section Break",
   "label": "Enable and disable"
  },
  {
   "fieldname": "enabled_on",
   "fieldtype": "Datetime",
   "label": "Last Enabled On",
   "read_only": 1
  },
  {
   "fieldname": "enabled_by",
   "fieldtype": "Link",
   "label": "Last Enabled By",
   "options": "User",
   "read_only": 1
  },
  {
